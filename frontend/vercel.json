{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/config", "destination": "/api/config" },
    { "source": "/time", "destination": "/api/time" },
    { "source": "/symbols", "destination": "/api/symbols" },
    { "source": "/history", "destination": "/api/history" },
    { "source": "/search", "destination": "/api/search" },
    { "source": "/quotes", "destination": "/api/quotes" },
    { "source": "/instruments", "destination": "/api/instruments" },
    { "source": "/trade/:path*", "destination": "/api/trade/:path*" },
    { "source": "/bundles/:path*", "destination": "/api/cdn?path=bundles/:path*" },
    { "source": "/charting_library/:path*", "destination": "/api/cdn?path=charting_library/:path*" }
  ]
}
